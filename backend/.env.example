# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Production: дэлгүүр + админ subdomain (таслалаар)
# CORS_ORIGIN=https://itgelshop.mn,https://www.itgelshop.mn,https://admin.itgelshop.mn

# --- Database ---
# Локал (docker compose up -d):
DATABASE_URL="postgresql://itgel:itgel@localhost:5432/itgel?schema=public"
DIRECT_URL="postgresql://itgel:itgel@localhost:5432/itgel?schema=public"
# Supabase (Dashboard → Project Settings → Database → Connection string → Prisma):
#   DATABASE_URL="postgresql://postgres.<ref>:<НУУЦ-ҮГ>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.<ref>:<НУУЦ-ҮГ>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=product-images

# --- JWT ---
JWT_SECRET="change-me-in-production"
JWT_CUSTOMER_TTL=30d
JWT_ADMIN_TTL=12h

# --- SMS (dev дээр console mock) ---
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=itgel

# --- SMTP (Gmail) — хэрэглэгчийн и-мэйл баталгаажуулалт / нууц үг сэргээх ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Итгэл <noreply@example.com>

# --- Object storage ---
# STORAGE_PROVIDER: auto | r2 | supabase | mock
STORAGE_PROVIDER=auto

# Cloudflare R2 (S3-нийцтэй API ашиглана).
# R2 дээр: R2_REGION=auto, endpoint нь https://<account-id>.r2.cloudflarestorage.com,
# R2_PUBLIC_BASE_URL нь https://pub-<hash>.r2.dev эсвэл өөрийн домэйн.
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_FORCE_PATH_STYLE=true

# --- Cron ---
CRON_ENABLED=true

# --- Seed админ ---
ADMIN_EMAIL=admin@itgel.mn
ADMIN_PASSWORD=admin123
# Лизингийн админ (seed): leasing@itgel.mn
LEASING_ADMIN_PASSWORD=leasing123

# --- QPay (merchant.qpay.mn v2) ---
# Invoice code ихэвчлэн {CLIENT}_INVOICE (жишээ: SAIKHNAA_D_INVOICE).
QPAY_ENABLED=false
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=https://api.itgelshop.mn/api/orders/qpay/callback

# --- Лизингийн QPay (тусдаа merchant account) ---
# Дэлгүүрийн QPAY_* -г бүү дахин ашигла. Лизингийн төлбөр зөвхөн эндээр орно.
LEASING_QPAY_ENABLED=false
LEASING_QPAY_BASE_URL=https://merchant.qpay.mn/v2
LEASING_QPAY_CLIENT_ID=
LEASING_QPAY_CLIENT_SECRET=
LEASING_QPAY_INVOICE_CODE=
LEASING_QPAY_CALLBACK_URL=https://api.itgelshop.mn/api/orders/leasing-qpay/callback
