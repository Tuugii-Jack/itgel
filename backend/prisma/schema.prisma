// itgel — захиалгын дэлгүүрийн өгөгдлийн сан
// Бүх мөнгөн дүн Int (төгрөг), float хэрэглэхгүй.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase дээр DATABASE_URL нь pooler (6543, pgbouncer), DIRECT_URL нь шууд холболт (5432).
  // Локал Postgres дээр хоёулаа ижил байж болно.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  DRAFT
  CLOSED
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_BATCH
  IN_TRANSIT
  ARRIVED
  HANDED_OVER
  CANCELLED
}

enum Fulfilment {
  PICKUP
  DELIVERY
}

enum BatchStage {
  COLLECTING
  CLOSED
  AT_SUPPLIER
  IN_TRANSIT
  AT_WAREHOUSE
  DONE
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  DELIVERED
}

enum AdminRole {
  ADMIN
  STAFF
  LEASING
  OWNER
}

/// Бараа/төлбөрийн эзэн — дэлгүүр эсвэл лизингийн админ.
enum InventoryOwner {
  SHOP
  LEASING
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  QPAY
  OTHER
  /// Хуучин лизингийн админы бүртгэл. Шинэ төлбөрт ашиглахгүй.
  LEASING
}

model Category {
  id        String    @id @default(cuid())
  name      String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([isActive, sortOrder])
}

/**
 * Барааны загвар — дахин ашиглагдах хэсэг.
 *
 * Үнэ, хаах огноо, үлдэгдэл, төлөв нь энд БАЙХГҮЙ: тэдгээр нь тойрог бүрд
 * өөр байдаг тул `ProductRound` дээр байна. Нэг барааг олон удаа гаргахад
 * шинэ тойрог л нэмнэ — загвар нь хэвээрээ үлдэж, хуучин захиалга хөндөгдөхгүй.
 */
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  categoryId  String
  images      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  /// Хэн эзэмших вэ. Лизингийн админ зөвхөн өөрийн загварыг засна.
  ownerKind    InventoryOwner @default(SHOP)
  ownerAdminId String?

  category   Category         @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  sizeChart  SizeChartRow[]
  rounds     ProductRound[]
  orderItems OrderItem[]
  readyTransferLines ReadyStockTransferLine[]

  @@index([categoryId])
  @@index([deletedAt])
  @@index([ownerKind, ownerAdminId])
}

/**
 * Барааны нэг удаагийн гаргалт («тойрог»).
 *
 * Хэрэглэгчийн зүгээс захиалдаг зүйл нь ЯГ ЭНЭ — нийтийн API дээр `id` нь
 * тойргийн id байна. Ингэснээр тойрог бүрийн үнэ, ашиг, ирэх огноо тусдаа
 * бөгөөд хуучин тойргийг дараагийнх нь хэзээ ч дарж бичихгүй.
 */
model ProductRound {
  id        String @id @default(cuid())
  productId String

  /// Аль ачааны багцад зориулж гаргасан бэ. Багц үүсгээд бараагаа сонгоход
  /// энд холбогдоно; null бол багцаас гадуурх гаргалт (бэлэн бараа, хуучин
  /// тойрог). Тухайн тойргийн захиалгууд баталгаажихдаа энэ багц руу
  /// автоматаар орно.
  batchId String?

  /// Хэддэх удаагийн гаргалт бэ — бараа тус бүрд 1-ээс эхэлнэ.
  roundNo Int

  costPrice Int // анхны үнэ — хэрэглэгчийн API-д хэзээ ч буцаахгүй
  sellPrice Int
  /// Нэгж барааны карго үнэ ₮. Багцад нэмсний дараа админ оруулна.
  cargoFee  Int           @default(0)
  /// Агуулахад байгаа нийт ширхэг (түр нөөц + зарагдах боломжтой).
  stock     Int           @default(0)
  /// Төлбөр хүлээгдэж буй захиалгын нөөц. stock-оос тусад нь.
  reserved  Int           @default(0)
  /// Зарагдах боломжтой = stock − reserved. Жагсаалтын шүүлтэнд.
  available Int           @default(0)
  closeAt   DateTime? // null бол бэлэн бараа
  leadMinDays Int         @default(7)
  leadMaxDays Int         @default(14)
  status    ProductStatus @default(DRAFT)

  /// Админд зориулсан дотоод тэмдэглэл (жишээ нь нийлүүлэгчийн нэр).
  note String?

  /// Бэлэн барааны эзэн. Шинэ борлуулалтын QPay энэ эзэнд очно.
  ownerKind    InventoryOwner @default(SHOP)
  ownerAdminId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch        Batch?             @relation(fields: [batchId], references: [id])
  orderItems   OrderItem[]
  optionPrices RoundOptionPrice[]
  skuStocks    RoundSkuStock[]
  cargoFees    RoundCargoFee[]
  readyTransferLines ReadyStockTransferLine[]

  @@unique([productId, roundNo])
  @@index([status])
  @@index([closeAt])
  @@index([productId, createdAt])
  @@index([batchId])
  @@index([deletedAt, status, closeAt])
  @@index([ownerKind, ownerAdminId])
  @@index([closeAt, available])
}

/// Гаргалт дээрх сонголтын үнэ — ж: Хэмжээ S = 10,000₮, M = 20,000₮.
model RoundOptionPrice {
  id         String @id @default(cuid())
  roundId    String
  /// Хуучин нэг бүлгийн үнэ — хослол дээр хоосон байж болно.
  kind       String @default("")
  value      String @default("")
  /// Тогтвортой түлхүүр — ж: «Материал=A|Хэмжээ=2cm».
  skuKey     String
  selections Json
  sellPrice  Int
  costPrice  Int    @default(0)

  round ProductRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, skuKey])
  @@index([roundId])
}

/// Бэлэн барааны нэг хослол — ж: Хар + XL + Хөвөн = нэг бараа, нэг үлдэгдэл.
model RoundSkuStock {
  id          String @id @default(cuid())
  roundId     String
  /// Тогтвортой түлхүүр — ж: «Материал=Хөвөн|Хэмжээ=XL|Өнгө=Хар».
  skuKey      String
  selections  Json
  stock       Int
  reserved    Int @default(0)
  available   Int @default(0)

  round ProductRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, skuKey])
  @@index([roundId])
}

/// Багцын барааны сонголт (хэмжээ/өнгө/…) бүрийн нэгж карго үнэ.
model RoundCargoFee {
  id         String @id @default(cuid())
  roundId    String
  /// Тогтвортой түлхүүр — ж: «Хэмжээ=XL|Өнгө=Хар».
  skuKey     String
  selections Json
  cargoFee   Int

  round ProductRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, skuKey])
  @@index([roundId])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  /// Сонголтын бүлгийн нэр — ж: «Хэмжээ», «Өнгө», «Багтаамж».
  kind      String
  value     String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, kind, value])
  @@index([productId, kind, sortOrder])
}

model SizeChartRow {
  id          String @id @default(cuid())
  productId   String
  size        String
  heightRange String
  chestCm     String
  sortOrder   Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Customer {
  id        String   @id @default(cuid())
  /// Холбоо барих и-мэйл — тохиргоонд хадгална. Нэвтрэлт утасны OTP.
  email     String?  @unique
  passwordHash String?
  emailVerifiedAt DateTime?
  /// Нэвтрэх утас — зөвхөн phoneVerifiedAt тавигдсан бол нэвтрэх эрх.
  phone     String?  @unique
  phoneVerifiedAt DateTime?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Хадгалсан хаяг — хүргэлт сонгоход автоматаар орно.
  district    String?
  khoroo      String?
  addressText String?

  /// Мэдэгдлийн тохиргоо (профайл дээрх 3 сэлгүүр).
  notifyPayment Boolean @default(true)
  notifyArrival Boolean @default(true)
  notifyPromo   Boolean @default(false)

  /// Төлбөрийн данс / шилжүүлгийн сонголт.
  bankName          String  @default("")
  bankAccountNumber String  @default("")
  bankAccountName   String  @default("")
  defaultPayoutBank Boolean @default(false)

  orders        Order[]
  refundPayouts RefundPayout[]
  emailOtps     EmailOtp[]
  phoneOtps     PhoneOtp[]
  checkoutKeys  CheckoutIdempotency[]
}

model PhoneOtp {
  id        String    @id @default(cuid())
  phone     String
  code      String
  /// LOGIN | CHANGE_PHONE | ADMIN_PHONE
  purpose   String    @default("LOGIN")
  /// Хуучин клиент нэр илгээсэн бол verify дээр Customer-д бичнэ.
  name      String?
  customerId    String?
  adminUserId   String?
  previousPhone String?
  /// Rate limit — олон instance дээр IP-г DB-ээр тоолно.
  ip            String?
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt])
  @@index([phone, purpose, createdAt])
  @@index([customerId, purpose, createdAt])
  @@index([adminUserId, purpose, createdAt])
  @@index([ip, createdAt])
}

/// SMS илгээлтийн оролдлого — хүлээн авсан (queued) болон хүргэгдсэн (delivered) тусдаа.
model SmsDispatch {
  id                String    @id @default(cuid())
  /// shop | leasing
  channel           String
  /// otp_login | otp_change | arrival | leasing_custom | leasing_schedule | leasing_pay
  purpose           String
  /// callpro | http | console | disabled
  provider          String
  phone             String
  providerMessageId String?
  /// queued | pending | delivered | failed | unknown
  status            String
  attempt           Int       @default(1)
  error             String?
  relatedType       String?
  relatedId         String?
  idempotencyKey    String    @unique
  checkCount        Int       @default(0)
  nextCheckAt       DateTime?
  lastCheckedAt     DateTime?
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, nextCheckAt])
  @@index([relatedType, relatedId, createdAt])
  @@index([phone, purpose, createdAt])
  @@index([providerMessageId])
}

/// Нэг checkout үйлдлийн давхар захиалгыг (customerId, key) unique-аар хориглоно.
model CheckoutIdempotency {
  id             String   @id @default(cuid())
  customerId     String
  idempotencyKey String
  payloadHash    String
  /// Үүсгэсэн захиалгын нийтийн хариу. Ижил key+payload дахин ирвэл энэ JSON буцна.
  response       Json?
  orderIds       String[] @default([])
  createdAt      DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, idempotencyKey])
  @@index([createdAt])
}

model EmailOtp {
  id        String    @id @default(cuid())
  email     String
  code      String
  /// VERIFY | RESET | CHANGE_EMAIL
  purpose   String
  customerId String?
  previousEmail String?
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([customerId, purpose, createdAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  /// Хуучин үндсэн дугаар (харуулах). Нэвтрэлт `AdminLoginPhone`-оор.
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  /// JWT tv — гарах / идэвхгүй / нууц үг. Нэвтрэлт болон дугаар нэмэхэд өсгөхгүй.
  tokenVersion    Int       @default(0)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  loginPhones AdminLoginPhone[]
}

/// Нэг админд олон баталгаажсан нэвтрэх дугаар. Дугаар солихгүй, нэмнэ.
model AdminLoginPhone {
  id          String    @id @default(cuid())
  adminUserId String
  phone       String    @unique
  verifiedAt  DateTime
  createdAt   DateTime  @default(now())

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model Order {
  id          String      @id @default(cuid())
  code        String      @unique // PH-XXXXXX
  customerId  String
  status      OrderStatus @default(NEW)

  /// --- Мөнгөн дүн ---
  /// Эх сурвалж нь Payment дэвтэр. Эдгээр багана нь хайлт, эрэмбэлэлтэд
  /// зориулсан кэш бөгөөд recalcOrderTotals() -ээр л шинэчлэгдэнэ.
  subtotal    Int @default(0) // идэвхтэй мөрүүдийн нийлбэр
  /// Хүргэлтийн хураамж — дэлгүүр авдаггүй, үргэлж 0. Талбарыг хуучин бичлэгт үлдээнэ.
  deliveryFee Int @default(0)
  /// Агуулахад үнэгүй хоногоос хэтэрсэн хадгалалтын хураамж (кэш — cron/sync-ээр шинэчлэгдэнэ).
  storageFee  Int @default(0)
  /// Карго хураамж — идэвхтэй мөр бүрийн нэгж үнэ × ширхэг (кэш — syncOrderCargoFee).
  cargoFee    Int @default(0)
  /// Дэвтрийн PAYMENT мөрүүдийн нийлбэр.
  paidAmount     Int @default(0)
  /// Дэлгүүрийн касс (карго/агуулах) руу орсон PAYMENT − SHOP REFUND.
  shopPaidAmount Int @default(0)
  /// Дэвтрийн REFUND мөрүүдийн нийлбэр.
  refundedAmount Int @default(0)
  /// subtotal + storageFee + cargoFee − (paidAmount − refundedAmount). Сөрөг байвал илүү төлсөн.
  dueAmount      Int @default(0)

  batchId     String?
  /// Багцаас түр хассан (ихэвчлэн төлбөр дутуу). batchId хэвээр — дахин оруулж болно.
  batchOmittedAt DateTime?
  fulfilment  Fulfilment? // бараа ирсний дараа хэрэглэгч сонгоно
  /// Очиж авах үеийн карго төлбөр: CASH | QPAY. Хүргэлт/хоосон бол null.
  cargoPayMethod String?
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  // timeline-д хэрэглэгдэх төлөв бүрийн огноо
  confirmedAt  DateTime?
  inBatchAt    DateTime?
  inTransitAt  DateTime?
  arrivedAt    DateTime?
  handedOverAt DateTime?
  cancelledAt  DateTime?

  /// Ирсэн SMS-ийн илгээх хүсэлтийг үйлчилгээ хүлээн авсан огноо. Хүргэгдсэн гэсэн үг биш.
  arrivalNotifiedAt DateTime?

  /// Хэрэглэгч "мөнгө шилжүүлсэн" гэж мэдэгдсэн огноо. Админ эдгээрийг
  /// эхэнд шалгана; автомат цуцлалтад ч өртөхгүй. Төлбөр орсны баталгаа БИШ.
  paymentClaimedAt DateTime?

  /// QPay нэхэмжлэлийн id — invoice үүсгэсний дараа. Төлбөр шалгах/webhook-д ашиглана.
  qpayInvoiceId String?
  qpayInvoiceAt DateTime?
  /// Лизингийн захиалгын карго — дэлгүүрийн (SHOP) QPay.
  qpayCargoInvoiceId String?

  /// Лизингээр авсан захиалга. Энгийн QPay захиалгад false.
  isLeasing  Boolean @default(false)
  /// Нийт үнийн 10% — лизингийн шимтгэл. Лизинг биш бол 0.
  leasingFee Int     @default(0)

  /// Төлбөр хүлээн авагч. Лизингийн бэлэн борлуулалт isLeasing=false ч LEASING байна.
  payeeKind InventoryOwner @default(SHOP)
  /// Итгэлд төлөх хариуцагчийн snapshot. Тохиргоо солигдсон ч энэ захиалгын тооцоо үлдэнэ.
  leasingOperatorAdminId String?

  /// Өрийг төлөгдсөн гэж биш, тусдаа хаалтаар хаасан дүн. Payment мөр биш.
  writtenOffAmount Int       @default(0)
  debtClosedAt     DateTime?
  debtCloseReason  String?

  customer Customer    @relation(fields: [customerId], references: [id])
  batch    Batch?      @relation(fields: [batchId], references: [id])
  items    OrderItem[]
  delivery Delivery?
  payments Payment[]
  qpayInvoices QpayInvoice[]
  readyTransfers ReadyStockTransfer[]
  itgelSettlements ItgelSettlement[]
  moneyExceptions  MoneyException[]

  @@index([status])
  @@index([customerId])
  @@index([batchId])
  @@index([createdAt])
  /// «Төлбөр дутуу захиалга» шүүхэд.
  @@index([dueAmount])
  @@index([deletedAt, status, createdAt])
  @@index([isLeasing, createdAt])
  @@index([payeeKind, createdAt])
  @@index([leasingOperatorAdminId])
  @@index([debtClosedAt])
}

/// Keep every invoice associated with its order, including replaced/cancelled invoices.
model QpayInvoice {
  id        String   @id
  /// Захиалгын нэхэмжлэл. Итгэлд төлөх тооцооны invoice дээр null.
  orderId   String?
  account   String
  /// ORDER | CARGO | ITGEL_SETTLEMENT
  purpose   String   @default("ORDER")
  amount    Int      @default(0)
  settlementPaymentId String?
  createdAt DateTime @default(now())

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]
  settlementPayment ItgelSettlementPayment? @relation(fields: [settlementPaymentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([purpose, createdAt])
  @@index([settlementPaymentId])
}

/// Орлого, буцаалт бүрийн бичилт. Устгагдахгүй — залруулга нь эсрэг мөр.
model Payment {
  id        String        @id @default(cuid())
  orderId   String
  kind      PaymentKind
  /// Үргэлж эерэг. Чиглэлийг `kind` заана.
  amount    Int
  method    PaymentMethod @default(BANK_TRANSFER)
  /// Банкны гүйлгээний утга, QPay-ийн дугаар гэх мэт.
  reference String?
  qpayInvoiceId String?
  note      String?
  /// SHOP = карго/агуулах (Итгэл). LEASING = лизингийн төлбөр. Хоосон = захиалгын үндсэн данс.
  payeeKind InventoryOwner?
  /// Хэн бүртгэсэн: "admin:<id>" | "system".
  actor     String
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  qpayInvoice QpayInvoice? @relation(fields: [qpayInvoiceId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([createdAt])
  @@index([qpayInvoiceId, kind])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  /// Аль тойргоос захиалсан бэ. Тайлан, үлдэгдэл энэ дээр тулгуурлана.
  roundId String
  /// Загварын id — тойргуудыг нийлүүлж тайлаглахад хэрэгтэй тул давхар хадгална.
  productId         String
  nameSnapshot      String
  /// Сонголтууд — ж: { "Хэмжээ": "M", "Өнгө": "Хар" }.
  selections        Json    @default("{}")
  /// Хуучин захиалга / тайлангийн нийцүүлэлт — «Хэмжээ»-ээс синк хийнэ.
  size              String?
  /// Хуучин захиалга / тайлангийн нийцүүлэлт — «Өнгө»-өөс синк хийнэ.
  color             String?
  qty               Int
  unitPrice         Int
  costPriceSnapshot Int

  /// Захиалах үеийн ирэх огнооны амлалт. Тойрог дахин гарсан ч энэ хөдлөхгүй.
  /// Бэлэн бараанд null — тэр нь маргааш гарт очно.
  arriveFrom DateTime?
  arriveTo   DateTime?

  /// Хэсэгчилсэн цуцлалт — мөр устгагдахгүй, тэмдэглэгдэнэ.
  /// Цуцлагдсан мөр subtotal, тайлангийн ашгийн аль алинд ордоггүй.
  cancelledAt  DateTime?
  cancelReason String?

  /// Агуулахад ирсэн огноо — мөр бүтнээр (arrivedQty >= qty) ирэхэд тавина.
  arrivedAt DateTime?
  /// Энэ мөрөөс агуулахад ирсэн ширхэг (0..qty). Дутуу ирвэл FIFO-оор нэмэгдэнэ.
  arrivedQty Int @default(0)
  /// Хэрэглэгчид хүлээлгэн өгсөн огноо (хэсэгчилсэн авах боломжтой).
  handedOverAt DateTime?
  /// Ирсэн мөр бүрийн авах арга — захиалгад хольж болно.
  fulfilment   Fulfilment?

  /// Лизингийн бэлэн бараанд шилжүүлсэн. Цуцлалттой хамт, үлдэгдэл буцаахгүй.
  transferredAt   DateTime?
  transferredQty  Int       @default(0)
  readyTransferId String?

  /// NONE | RESERVED | CONSUMED | RELEASED — бэлэн барааны нөөцийн төлөв.
  stockHold       String  @default("NONE")
  /// Цуцлагдсаны дараа төлбөр орсон ч үлдэгдэл хүрээгүй.
  stockShortfall  Boolean @default(false)

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  round   ProductRound @relation(fields: [roundId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  readyTransfer ReadyStockTransfer? @relation(fields: [readyTransferId], references: [id])
  itgelSettlement ItgelSettlement?

  @@index([orderId])
  @@index([productId])
  @@index([roundId])
  @@index([roundId, cancelledAt])
  @@index([arrivedAt])
  @@index([handedOverAt])
  @@index([readyTransferId])
  @@index([transferredAt])
  @@index([stockHold])
}

/// Лизингийн захиалгаас бэлэн бараанд шилжүүлсэн бүртгэл. Орлого биш.
model ReadyStockTransfer {
  id               String   @id @default(cuid())
  sourceOrderId    String
  ownerAdminId     String
  reason           String
  /// Шилжүүлэх үеийн цэвэр орлого — дахин орлого болгон бүртгэхгүй.
  paidKeptAmount   Int
  /// Энэ үйлдлээр хаасан өр. Payment мөр биш.
  dueClosedAmount  Int
  wroteOffDebt     Boolean  @default(false)
  remainingActiveQty Int    @default(0)
  actor            String
  createdAt        DateTime @default(now())

  sourceOrder Order                    @relation(fields: [sourceOrderId], references: [id])
  lines       ReadyStockTransferLine[]
  items       OrderItem[]
  itgelSettlements ItgelSettlement[]

  @@index([sourceOrderId])
  @@index([ownerAdminId, createdAt])
}

model ReadyStockTransferLine {
  id              String @id @default(cuid())
  transferId      String
  orderItemId     String
  sourceRoundId   String
  destProductId   String
  destRoundId     String
  qty             Int
  resaleUnitPrice Int
  nameSnapshot    String
  selections      Json   @default("{}")

  transfer    ReadyStockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  destProduct Product            @relation(fields: [destProductId], references: [id])
  destRound   ProductRound       @relation(fields: [destRoundId], references: [id])

  @@index([transferId])
  @@index([destRoundId])
  @@index([orderItemId])
}

model Batch {
  id        String     @id @default(cuid())
  name      String
  stage     BatchStage @default(IN_TRANSIT)

  /// Захиалга авах эцсийн хугацаа — багцад бараа нэмэхэд тойргийн closeAt
  /// нь үүнээс анхдагчаар авна. Хугацаа өнгөрөхөд cron тойргуудыг хаана.
  deadline DateTime?

  closedAt  DateTime?
  weightKg  Int? // граммаар биш, бүхэл кг
  etaFrom   DateTime?
  etaTo     DateTime?
  /// Карго/тээврийн лавлагаа — нэрээс тусдаа. Хуучин багцад хоосон.
  cargoRef  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  orders       Order[]
  rounds       ProductRound[]
  arrivalNotes BatchArrivalNote[]

  @@index([stage])
}

/// Гэмтэл/дутуу/илүү — борлуулах үлдэгдэл, төлбөрт автоматаар нөлөөлөхгүй.
model BatchArrivalNote {
  id         String   @id @default(cuid())
  batchId    String
  roundId    String
  skuKey     String   @default("")
  selections Json     @default("{}")
  /// DAMAGED | SHORT | EXCESS
  kind       String
  qty        Int
  note       String   @default("")
  actor      String
  createdAt  DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([roundId])
}

model Delivery {
  id           String         @id @default(cuid())
  orderId      String         @unique
  scheduledDay DateTime // өдрийн эхлэл (UB цагаар)
  district     String
  khoroo       String?
  addressText  String?
  fee          Int            @default(0)
  courierName  String?
  status       DeliveryStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([scheduledDay, status])
}

model Ad {
  id        String    @id @default(cuid())
  title     String    @default("")
  imageUrl  String
  linkUrl   String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
}

model Setting {
  id                  Int      @id @default(1)
  storeName           String   @default("itgel")
  phone               String   @default("")
  address             String   @default("")
  workHours           String   @default("")
  facebookUrl         String   @default("")
  defaultLeadMinDays  Int      @default(7)
  defaultLeadMaxDays  Int      @default(14)
  smsOnArrival        Boolean  @default(true)
  autoCloseOnDeadline Boolean  @default(true)
  /// Хүргэлтийн дүүргүүд — түлхүүр нь нэр. Утга ашиглагдахгүй (хуучин хураамжийн хүснэгт).
  deliveryFees        Json     @default("{}")
  deliveryDailyLimit  Int      @default(20)

  /// --- Төлбөр хүлээн авах данс ---
  /// Захиалга өгсний дараа хэрэглэгчид харагдана. Хоосон бол данс харуулахгүй.
  bankName          String @default("")
  bankAccountNumber String @default("")
  bankAccountName   String @default("")
  /// Дансны доор нэмж бичих чөлөөт заавар (сонголтоор).
  paymentNote       String @default("")
  /// Мөнгө ороогүй захиалгыг хэдэн цагийн дараа автоматаар цуцлах. 0 = цуцлахгүй.
  unpaidCancelHours Int    @default(12)
  /// Агуулахад ирснээс хойш үнэгүй хадгалах хоног. Дараа нь storageFeePerDay тооцогдоно.
  storageFreeDays   Int    @default(7)
  /// Үнэгүй хоногоос хэтэрсэн хоног бүрт (мөр × тоо) нэмэгдэх хураамж ₮. 0 = унтраана.
  storageFeePerDay  Int    @default(1000)

  /// Лизингийн шимтгэлийн шатлал: [{ minAmount, ratePercent }]. Хоосон бол 10%.
  leasingFeeTiers     Json   @default("[]")
  /// Сагсан дээрх богино тайлбар. {percent} {fee} орно.
  leasingChoiceHint   String @default("")
  leasingTermsTitle   String @default("Лизингийн нөхцөл")
  leasingTermsBody    String @default("")
  /// Үндсэн төлбөрийн хоногийн зай. Ж: [5,8,8] = 3 төлөлт, нийт 21 хоног.
  leasingPayGaps      Json   @default("[5,8,8]")
  /// Сануулгын SMS загвар. Хоосон бол үндсэн текст. {ner} {dun} {ognoo} {honog}
  leasingSmsDueToday      String @default("")
  leasingSmsOverdue       String @default("")
  leasingSmsArrivedUnpaid String @default("")

  /// Лизингийн бэлэн борлуулалт / шилжүүлгийн данс. Дэлгүүрийн данс руу буцахгүй.
  leasingBankName          String @default("")
  leasingBankAccountNumber String @default("")
  leasingBankAccountName   String @default("")
  leasingPaymentNote       String @default("")

  /// Хэрэглэгчид харагдах лизингийн холбоо барих. Дэлгүүрийн phone/facebook-ийг солихгүй.
  leasingPublicName    String @default("")
  leasingContactPhone  String @default("")
  leasingChatUrl       String @default("")
  /// Итгэлд төлөх өрийн хариуцсан лизингийн админ. Хоосон бол өр үүсгэхгүй.
  leasingSettlementAdminId String?

  updatedAt DateTime @updatedAt
}

/// Лизингийн баталгаажсан борлуулалтаас Итгэлд төлөх барааны бүтэн дүн.
model ItgelSettlement {
  id                String   @id @default(cuid())
  sourceOrderItemId String   @unique
  sourceOrderId     String
  sourceOrderCode   String
  customerId        String
  customerName      String   @default("")
  ownerAdminId      String
  productId         String
  roundId           String
  productName       String
  qty               Int
  unitPrice         Int
  amount            Int
  confirmedAt       DateTime
  /// OPEN | INVOICED | PENDING_BANK | PAID | VOID
  status            String   @default("OPEN")
  paidAmount        Int      @default(0)
  remainingAmount   Int
  lockPaymentId     String?
  readyTransferId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sourceOrderItem OrderItem  @relation(fields: [sourceOrderItemId], references: [id], onDelete: Restrict)
  sourceOrder     Order      @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  readyTransfer   ReadyStockTransfer? @relation(fields: [readyTransferId], references: [id], onDelete: SetNull)
  lines           ItgelSettlementPaymentLine[]

  @@index([ownerAdminId, confirmedAt])
  @@index([status, confirmedAt])
  @@index([sourceOrderId])
  @@index([lockPaymentId])
}

model ItgelSettlementPayment {
  id            String   @id @default(cuid())
  ownerAdminId  String
  /// QPAY | BANK_TRANSFER
  method        String
  amount        Int
  /// PENDING | CONFIRMED | REJECTED | SUPERSEDED
  status        String   @default("PENDING")
  qpayInvoiceId String?  @unique
  bankRef       String?
  bankDate      DateTime?
  receiptUrl    String?
  claimedBy     String
  confirmedBy   String?
  /// Анх баталгаажсан агшин. Callback давтахад өөрчлөхгүй.
  confirmedAt   DateTime?
  /// EVENT = баталгаажуулалтын үед бичсэн. AUDIT = AuditLog-оос нөхсөн. null = огноо тодорхойгүй.
  confirmedAtSource String?
  rejectedReason String?
  note          String?
  /// QPay QR/deeplink — refresh/relogin-д дахин үүсгэхгүй.
  invoicePayload Json?
  senderInvoiceNo String? @unique
  invoiceAttemptAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines         ItgelSettlementPaymentLine[]
  qpayInvoices  QpayInvoice[]
  exceptions    MoneyException[]

  @@index([ownerAdminId, createdAt])
  @@index([status, createdAt])
  @@index([status, confirmedAt])
}

model ItgelSettlementPaymentLine {
  id            String @id @default(cuid())
  paymentId     String
  settlementId  String
  amount        Int

  payment    ItgelSettlementPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  settlement ItgelSettlement        @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@unique([paymentId, settlementId])
  @@index([settlementId])
}

/// Хоцорсон төлбөр, илүү мөнгө, зөрсөн дүн — чимээгүй алдахгүй.
model MoneyException {
  id                   String   @id @default(cuid())
  /// LATE_AFTER_CANCEL | STOCK_SHORTFALL | SETTLEMENT_OVERPAY | SETTLEMENT_MISMATCH | SETTLEMENT_OWNER_MISSING | SETTLEMENT_UNMATCHED
  kind                 String
  orderId              String?
  settlementPaymentId  String?
  qpayInvoiceId        String?
  /// QPay payment_id эсвэл sender_invoice_no — давтан callback-ийг ялгана.
  reference            String?
  amount               Int
  /// OPEN | RESOLVED
  status               String   @default("OPEN")
  note                 String?
  actor                String
  createdAt            DateTime @default(now())
  resolvedAt           DateTime?
  resolvedBy           String?

  order              Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  settlementPayment  ItgelSettlementPayment? @relation(fields: [settlementPaymentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId])
  @@index([kind, status])
  @@index([qpayInvoiceId, status])
}

/// Админ буцаалтын мөнгийг хэрэглэгчийн данс руу шилжүүлсний баталгаа (10/20/30).
model RefundPayout {
  id         String   @id @default(cuid())
  customerId String
  /// YYYY-MM-DD — сарын 10, 20, 30 (богино сард сарын сүүл).
  payoutDay  String
  amount     Int
  paidAt     DateTime @default(now())
  actor      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, payoutDay])
  @@index([payoutDay])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String // "admin:<id>" | "customer:<id>" | "system"
  action    String // CREATE | UPDATE | DELETE | STATUS_CHANGE ...
  entity    String // Product | Order | Setting ...
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
